# MilkFlow — Production Environment Variables
# Copy to .env.production on your hosting provider (Render, Railway, or VPS)

# --- Core Service ---
PROJECT_NAME="MilkFlow"
ENVIRONMENT="production"
SECRET_KEY="generate-a-strong-64-char-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200   # 30 days token expiry for mobile PWA retention

# --- PostgreSQL Database (Live on Neon.tech Singapore) ---
DATABASE_URL="postgresql://neondb_owner:npg_y7cNeC4UuXAJ@ep-little-firefly-b3euwbho-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- CORS & Security ---
FRONTEND_URL="https://milkflow.vercel.app"
ALLOWED_HOSTS="api.milkflow.in,milkflow.onrender.com,localhost"

# --- WhatsApp Cloud API (Optional stage 2, currently uses free wa.me links) ---
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
